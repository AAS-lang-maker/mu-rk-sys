<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 核心：namespace必须等于UserMapper接口的全限定类名（包名+接口名） -->
<mapper namespace="com.music.Mapper.TagsMapper">


    <insert id="add" useGeneratedKeys="true" keyProperty="tagsId" parameterType="com.music.pojo.Tags">
      insert into tags_dictionary(tag_name, use_count)
      values
          (#{tagName},#{useCount})
    </insert>
    <select id="pageQuery" resultType="com.music.pojo.Tags">
        select * from tags_dictionary
        <where>
            <if test="TagsName != null and TagsName != ''">
                and tag_name like concat('%',#{TagsName},'%')
            </if>
        </where>
    </select>

</mapper>